{
  "manifest_version": 3,
  "name": "Lovable Extension",
  "version": "1.0.0",
  "description": "Extension for Lovable services",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
